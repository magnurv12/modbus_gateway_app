{
  // ⇧⌘P → "Tasks: Run Task". "Testes" é a tarefa de teste padrão e
  // "Gerar código" a de build padrão (⇧⌘B).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Gerar código",
      "detail": "freezed/json_serializable — rode após mudar entidades, estados ou models",
      "type": "shell",
      "command": "dart run build_runner build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Gerar código (watch)",
      "detail": "regera automaticamente a cada arquivo salvo",
      "type": "shell",
      "command": "dart run build_runner watch",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Testes",
      "type": "shell",
      "command": "flutter test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Analisar",
      "type": "shell",
      "command": "flutter analyze",
      "problemMatcher": "$dart-flutter-analyze"
    },
    {
      "label": "Limpar e reinstalar dependências",
      "type": "shell",
      "command": "flutter clean && flutter pub get && dart run build_runner build",
      "problemMatcher": []
    },
    {
      "label": "Build APK (dev)",
      "type": "shell",
      "command": "flutter build apk --release --dart-define=ENVIRONMENT=dev",
      "problemMatcher": []
    },
    {
      "label": "Build APK (demo)",
      "type": "shell",
      "command": "flutter build apk --release --dart-define=ENVIRONMENT=demo",
      "problemMatcher": []
    }
  ]
}
